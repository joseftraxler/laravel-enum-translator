{
    "name": "joseftraxler/laravel-enum-translator",
    "description": "Laravel extension for translating native php enum values.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "JosefTraxler\\LaravelEnumTranslator\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Josef Traxler"
        }
    ],
    "require": {
        "php": ">=8.4",
        "illuminate/support": ">=12",
        "illuminate/contracts": ">=12"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs": "php-cs-fixer check",
        "stan": "phpstan analyse src -l max"
    }
}
