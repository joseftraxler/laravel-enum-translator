{
    "name": "joseftraxler/laravel-enum-translator",
    "description": "Lightweight Laravel helper for translating native PHP enums using attributes, Laravel translator, or human-readable fallback.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "enum",
        "translation",
        "translator",
        "php-enum",
        "laravel-enum",
        "attribute",
        "localization",
        "i18n",
        "l10n"
    ],
    "homepage": "https://github.com/JosefTraxler/laravel-enum-translator",
    "support": {
        "issues": "https://github.com/JosefTraxler/laravel-enum-translator/issues",
        "source": "https://github.com/JosefTraxler/laravel-enum-translator"
    },
    "authors": [
        {
            "name": "Josef Traxler"
        }
    ],
    "autoload": {
        "psr-4": {
            "JosefTraxler\\LaravelEnumTranslator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "illuminate/support": ">=12",
        "illuminate/contracts": ">=12"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "pestphp/pest": "^4.6"
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs": "php-cs-fixer check",
        "stan": "phpstan analyse src tests -l max",
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
